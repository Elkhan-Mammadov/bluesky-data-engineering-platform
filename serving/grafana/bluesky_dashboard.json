      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "warehouse-db-postgres"
          },
          "rawSql": "SELECT minute_bucket AS \"time\", event_type, SUM(event_count)::float / 60.0 AS events_per_second\n    FROM realtime.event_counts_by_minute\n    WHERE minute_bucket > now() - interval '15 minutes'\n      AND event_type IN (${event_type:sqlstring})\n    GROUP BY minute_bucket, event_type\n    ORDER BY minute_bucket",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
