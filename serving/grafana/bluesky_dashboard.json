      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "warehouse-db-postgres"
          },
          "rawSql": "SELECT * FROM (\n        SELECT ingested_at AS time, 'post' AS event_type, language, array_to_string(hashtags, ', ') AS hashtags, user_id_hash\n        FROM raw.posts\n        UNION ALL\n        SELECT ingested_at, 'like', NULL, NULL, user_id_hash FROM raw.likes\n        UNION ALL\n        SELECT ingested_at, 'repost', NULL, NULL, user_id_hash FROM raw.reposts\n        UNION ALL\n        SELECT ingested_at, 'follow', NULL, NULL, user_id_hash FROM raw.follows\n        UNION ALL\n        SELECT ingested_at, 'block', NULL, NULL, user_id_hash FROM raw.blocks\n        UNION ALL\n        SELECT ingested_at, 'profile_update', NULL, NULL, user_id_hash FROM raw.profile_updates\n    ) all_events\n    ORDER BY time DESC LIMIT 20",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
