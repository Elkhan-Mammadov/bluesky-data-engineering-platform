    {
      "id": 8,
      "type": "timeseries",
      "title": "Events per second by type (last 15 min)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "postgres",
