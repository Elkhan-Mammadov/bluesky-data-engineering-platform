# ==============================================================================
# Bluesky Real-Time Data Platform - environment variables
#
# Copy this file to .env and fill in real values:
#   make env
#
# Never commit the real .env file. All values below are safe placeholders.
# ==============================================================================

# ---------- Data source mode ----------
# jetstream = read real Bluesky data from the public Jetstream feed
# simulator = use the synthetic fallback generator instead
SOURCE_MODE=jetstream

# ---------- Privacy ----------
# Random secret used to hash Bluesky user DIDs before they are stored anywhere.
# Generate a real one with: openssl rand -hex 32
USER_ID_HASH_SALT=change-this-to-a-random-secret-value

# ---------- Sampling ----------
# Fraction of users whose events are kept, chosen deterministically by hashing
# the user DID (0.10 = keep 10% of users, all of their events).
SAMPLING_RATE=0.10

# ---------- source-db (OLTP, operational database) ----------
SOURCE_DB_HOST=source-db
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=bluesky_source
SOURCE_DB_USER=source_app
SOURCE_DB_PASSWORD=change-this-source-db-password
# Dedicated replication role used only by Debezium
SOURCE_DB_REPLICATION_USER=debezium
SOURCE_DB_REPLICATION_PASSWORD=change-this-replication-password

# ---------- warehouse-db (analytical database) ----------
WAREHOUSE_DB_HOST=warehouse-db
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=bluesky_warehouse
WAREHOUSE_DB_USER=warehouse_app
WAREHOUSE_DB_PASSWORD=change-this-warehouse-db-password

# ---------- airflow-metadata-db ----------
AIRFLOW_DB_HOST=airflow-metadata-db
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-this-airflow-db-password

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONNECT_URL=http://kafka-connect:8083

# ---------- Airflow ----------
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=change-this-fernet-key
AIRFLOW__WEBSERVER__SECRET_KEY=change-this-webserver-secret-key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-this-admin-password
AIRFLOW_MEMORY_LIMIT=2g

# ---------- Spark ----------
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g

# ---------- Retention ----------
DATA_RETENTION_DAYS=7

# ---------- dbt schedule ----------
DBT_RUN_INTERVAL_MINUTES=5

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
