    {
      "id": 6,
      "type": "stat",
      "title": "Quarantine %",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "warehouse-db-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "warehouse-db-postgres"
          },
          "rawSql": "WITH totals AS (\n        SELECT COALESCE(SUM(row_count), 0) AS total_rows, COALESCE(SUM(valid_row_count), 0) AS valid_rows\n        FROM dq.stream_batches WHERE created_at > now() - interval '5 minutes'\n    )\n    SELECT CASE WHEN total_rows = 0 THEN 0 ELSE ROUND(100.0 * (total_rows - valid_rows) / total_rows, 2) END AS value\n    FROM totals",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
